+TEST(WalletLegacyBenchmark, LegacyCompatibilityBoundaryT44AndT259) {
+  System::Dispatcher dispatcher;
+  (void)dispatcher;
+  Logging::ConsoleLogger logger(Logging::ERROR);
+  CryptoNote::Currency currency = CryptoNote::CurrencyBuilder(logger)
+      .testnet(true)
+      .upgradeHeightV2(1).upgradeHeightV3(1).upgradeHeightV4(1)
+      .upgradeHeightV5(1000000).upgradeHeightV6(1000000)
+      .currency();
+  TestBlockchainGenerator generator(currency);
+
+  auto fixedSecret = [](uint8_t multiplier, uint8_t addend) {
+    Crypto::SecretKey secret{};
+    for (std::size_t i = 0; i < sizeof(secret.data); ++i) {
+      secret.data[i] = static_cast<uint8_t>(i * multiplier + addend);
+    }
+    return secret;
+  };
+  CryptoNote::AccountKeys targetAccount{};
+  targetAccount.spendSecretKey = fixedSecret(29, 7);
+  const CryptoNote::PqWalletKeys target =
+      CryptoNote::derivePqWalletKeys(targetAccount.spendSecretKey);
+  const CryptoNote::PqWalletKeys sender =
+      CryptoNote::derivePqWalletKeys(fixedSecret(17, 9));
+
+  const uint64_t amount44 = 44000;
+  const uint64_t amount259 = 259000;
+  CryptoNote::Transaction legacy44 = makePqPayToLegacyV1(
+      sender, target, 1000000, amount44, 0x91, 44);
+  CryptoNote::Transaction legacy259 = makePqPayToLegacyV1(
+      sender, target, 1000000, amount259, 0x92, 259);
+  generator.setTxFee(CryptoNote::getObjectHash(legacy44), 1000000 - amount44);
+  generator.setTxFee(CryptoNote::getObjectHash(legacy259), 1000000 - amount259);
+  generator.addTxToBlockchain(legacy44);
+  generator.addTxToBlockchain(legacy259);
+  const uint32_t tipHeight =
+      static_cast<uint32_t>(generator.getBlockchain().size() - 1);
+  INodeTrivialRefreshStub node(generator);
+
+  struct BoundaryResult {
+    uint64_t balance;
+    std::size_t transactionCount;
+    std::map<uint32_t, int64_t> byT;
+  };
+  auto scan = [&](uint32_t maxT) {
+    CryptoNote::WalletLegacy wallet(currency, node, logger);
+    wallet.setPqLegacyScanWindow(maxT);
+    wallet.initWithKeys(targetAccount, "compatibility-boundary", 0);
+    const auto deadline =
+        std::chrono::steady_clock::now() + std::chrono::seconds(30);
+    while (wallet.pqSyncedHeight() < tipHeight &&
+           std::chrono::steady_clock::now() < deadline) {
+      std::this_thread::sleep_for(std::chrono::milliseconds(1));
+    }
+    EXPECT_GE(wallet.pqSyncedHeight(), tipHeight);
+    BoundaryResult result{wallet.actualBalance(), wallet.getTransactionCount(), {}};
+    for (std::size_t i = 0; i < result.transactionCount; ++i) {
+      const auto amounts = wallet.getTransactionSubaddressAmounts(i);
+      for (const auto& entry : amounts) result.byT[entry.first] += entry.second;
+    }
+    wallet.shutdown();
+    node.waitForAsyncContexts();
+    return result;
+  };
+
+  const BoundaryResult candidate = scan(1);
+  EXPECT_EQ(candidate.balance, 0u);
+  EXPECT_EQ(candidate.transactionCount, 0u);
+  EXPECT_TRUE(candidate.byT.empty());
+
+  const BoundaryResult baseline = scan(64);
+  EXPECT_EQ(baseline.balance, amount44);
+  EXPECT_EQ(baseline.transactionCount, 1u);
+  EXPECT_EQ(baseline.byT.at(44), static_cast<int64_t>(amount44));
+  EXPECT_EQ(baseline.byT.count(259), 0u);
+
+  const BoundaryResult recovery = scan(260);
+  EXPECT_EQ(recovery.balance, amount44 + amount259);
+  EXPECT_EQ(recovery.transactionCount, 2u);
+  EXPECT_EQ(recovery.byT.at(44), static_cast<int64_t>(amount44));
+  EXPECT_EQ(recovery.byT.at(259), static_cast<int64_t>(amount259));
+}
