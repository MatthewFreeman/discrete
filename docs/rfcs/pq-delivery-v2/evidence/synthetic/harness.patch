+CryptoNote::Transaction makePqPayMany(
+    const CryptoNote::PqWalletKeys& from,
+    const CryptoNote::PqWalletKeys& to,
+    uint64_t inAmount, uint64_t amountPerOutput, uint8_t seed,
+    std::size_t outputCount) {
+  std::vector<CryptoPQ::InputRef> refs(1);
+  for (auto& b : refs[0].prevTxid) b = seed;
+  refs[0].prevOutIndex = 1;
+  CryptoPQ::Hash256 fih = CryptoPQ::inputsHash(refs);
+  CryptoPQ::PqBuiltOutput src =
+      CryptoPQ::buildPqOutput(from.viewPub, from.spendPub, fih, 0, inAmount);
+  CryptoNote::PqSpendInput in;
+  for (std::size_t i = 0; i < 32; ++i) {
+    in.prevTxid.data[i] = static_cast<uint8_t>(seed + i);
+  }
+  in.prevOutIndex = 0;
+  in.amount = inAmount;
+  in.rho = src.rho;
+
+  std::vector<CryptoNote::PqSendOutput> outputs;
+  outputs.reserve(outputCount);
+  for (std::size_t i = 0; i < outputCount; ++i) {
+    outputs.push_back(CryptoNote::PqSendOutput{
+        to.viewPub, to.spendPub, amountPerOutput});
+  }
+  return CryptoNote::buildPqTransaction(
+      {in}, outputs, from.spendPub, from.spendSk);
+}
